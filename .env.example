# OpenAI-compatible local inference server
DND_MODEL_BASE_URL=http://127.0.0.1:1234/v1
DND_MODEL_NAME=local-model
# Optional documentation of the model file hosted by your inference server.
# DND_MODEL_PATH=E:/models/model.gguf

# Local embedding model and generated application data
DND_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DND_DATA_DIR=runtime
# Optional per-store overrides:
# DND_CHROMA_DIR=runtime/chroma
# DND_CHECKPOINT_DIR=runtime/checkpoints
# DND_ADVENTURE_DIR=runtime/adventures
# DND_PROFILE_DIR=runtime/profile

# Bounded runtime limits
# DND_MAX_AGENT_STEPS=12
# DND_MAX_PLAN_REVISIONS=3
# DND_MAX_DICE_COUNT=100
# DND_MAX_DICE_MODIFIER=1000
